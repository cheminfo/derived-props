  },
  "homepage": "https://github.com/cheminfo/derived-props#readme",
  "dependencies": {
    "is-any-array": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.3",
    "@zakodium/tsconfig": "^1.0.0",
    "eslint": "^9.23.0",
    "eslint-config-cheminfo-typescript": "^21.2.0",
    "immer": "^11.1.4",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.3"
  }
}
